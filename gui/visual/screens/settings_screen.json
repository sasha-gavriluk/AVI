{
  "id": "settings_panel",
  "type": "QWidget",
  "layout": "v",
  "children": [
    {
      "id": "title_label",
      "type": "QLabel",
      "text": "Налаштування Роботи (Massive & CCXT)",
      "style": "title"
    },

    {
      "type": "QLabel",
      "text": "КЛЮЧІ BYBIT",
      "style": "section"
    },
    {
      "type": "QWidget",
      "layout": "h",
      "children": [
        {
          "type": "QLabel",
          "text": "Ключ:",
          "style": "label",
          "minimum_width": 70
        },
        {
          "id": "input_bybit_key",
          "type": "QLineEdit",
          "style": "input",
          "placeholder_text": "ключ API"
        }
      ]
    },
    {
      "type": "QWidget",
      "layout": "h",
      "children": [
        {
          "type": "QLabel",
          "text": "Секрет:",
          "style": "label",
          "minimum_width": 70
        },
        {
          "id": "input_bybit_secret",
          "type": "QLineEdit",
          "style": "input",
          "placeholder_text": "секретний ключ"
        }
      ]
    },
    {
      "type": "QWidget",
      "layout": "h",
      "children": [
        {
          "id": "chk_show_keys",
          "type": "QCheckBox",
          "text": "Показати",
          "on_toggled": "app.toggle_keys"
        },
        {
          "id": "btn_save_keys",
          "type": "QPushButton",
          "text": "Зберегти ключі",
          "on_clicked": "app.save_keys"
        }
      ]
    },
    {
      "id": "keys_status",
      "type": "QLabel",
      "text": "",
      "style": "label",
      "word_wrap": true
    },

    {
      "type": "QLabel",
      "text": "Торговий режим:"
    },
    {
      "type": "QWidget",
      "layout": "h",
      "children": [
        {
          "id": "rb_futures",
          "type": "QRadioButton",
          "text": "Ф'ючерси",
          "checked": true,
          "on_toggled": "app.mode_changed"
        },
        {
          "id": "rb_bo",
          "type": "QRadioButton",
          "text": "БО",
          "on_toggled": "app.mode_changed"
        }
      ]
    },
    {
      "type": "QLabel",
      "text": "Ринок:"
    },
    {
      "type": "QWidget",
      "layout": "h",
      "children": [
        {
          "id": "rb_crypto",
          "type": "QRadioButton",
          "text": "Crypto",
          "checked": true,
          "on_toggled": "app.market_changed"
        },
        {
          "id": "rb_forex",
          "type": "QRadioButton",
          "text": "Forex",
          "on_toggled": "app.market_changed"
        }
      ]
    },
    {
      "type": "QLabel",
      "text": "Активи для аналізу:"
    },
    {
      "type": "QWidget",
      "layout": "h",
      "children": [
        {
          "id": "input_assets_list",
          "type": "QLineEdit",
          "text": ""
        },
        {
          "id": "btn_assets_dialog",
          "type": "QPushButton",
          "text": "Вибрати...",
          "on_clicked": "app.open_assets_dialog"
        }
      ]
    },
    {
      "type": "QLabel",
      "text": "Таймфрейм, на якому буде відбуватись торгівля:"
    },
    {
      "id": "timeframes_container",
      "type": "QWidget",
      "layout": "h",
      "children": []
    },
    {
      "type": "QLabel",
      "text": "Початковий баланс ($):"
    },
    {
      "id": "input_account_balance",
      "type": "QLineEdit",
      "text": "1000.0"
    },
    {
      "id": "btn_start",
      "type": "QPushButton",
      "text": "🚀 Запустити Термінал",
      "on_clicked": "app.start"
    },
    {
      "id": "status_label",
      "type": "QLabel",
      "text": "Готовий до запуску."
    }
  ]
}
