{
  "id": "trades_panel",
  "type": "QWidget",
  "layout": "v",
  "children": [
    {
      "id": "trades_title",
      "type": "QLabel",
      "text": "Торгівля ChronoSeer",
      "style": "title"
    },
    {
      "id": "trades_mode",
      "type": "QLabel",
      "text": "Режим не обрано",
      "style": "section"
    },

    {
      "id": "balance_row",
      "type": "QWidget",
      "layout": "h",
      "children": [
        {
          "id": "stat_balance",
          "type": "QLabel",
          "text": "БАЛАНС\n—",
          "style": "stat"
        },
        {
          "id": "stat_margin",
          "type": "QLabel",
          "text": "ЗАСТАВА НА УГОДУ\n—",
          "style": "stat"
        },
        {
          "id": "stat_drawdown",
          "type": "QLabel",
          "text": "ПРОСІДАННЯ\n—",
          "style": "stat"
        }
      ]
    },

    {
      "id": "position_badge",
      "type": "QLabel",
      "text": "ПОЗИЦІЯ ЗАКРИТА",
      "style": "badge_idle"
    },

    {
      "id": "btn_trade",
      "type": "QPushButton",
      "text": "▶  Старт",
      "style": "primary",
      "minimum_height": 44,
      "on_clicked": "trades.toggle"
    },

    {
      "id": "trade_status",
      "type": "QLabel",
      "text": "Очікування запуску.",
      "style": "label",
      "word_wrap": true
    },

    {
      "id": "cards_caption",
      "type": "QLabel",
      "text": "ВЕРДИКТИ МЕРЕЖІ",
      "style": "section"
    },
    {
      "id": "trade_cards",
      "type": "QWidget",
      "layout": "v"
    },

    {
      "id": "log_caption",
      "type": "QLabel",
      "text": "ЖУРНАЛ ТАКТУ",
      "style": "section"
    },
    {
      "id": "trade_log",
      "type": "QTextEdit",
      "style": "log",
      "read_only": true,
      "minimum_height": 120,
      "maximum_height": 220
    }
  ]
}
